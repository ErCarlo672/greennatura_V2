# GREENNATURA · greennatura.es · Apache (DonDominio)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.greennatura.es → greennatura.es (una sola dirección para Google)
  RewriteCond %{HTTP_HOST} ^www\.greennatura\.es$ [NC]
  RewriteRule ^ https://greennatura.es%{REQUEST_URI} [L,R=301]
  # http → https (también si el servidor va detrás de un proxy)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # HTML siempre fresco: los cambios se ven al momento
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # CSS y JS llevan ?v=AAAAMMDD, se pueden cachear una semana
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Imágenes y fuentes: un mes
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
